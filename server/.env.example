# Backend Configuration

# Server
PORT=5000
NODE_ENV=development

# Database URLs - MongoDB Atlas Cloud
# Format: mongodb+srv://username:password@cluster.server.mongodb.net/database_name
MONGO_USER_SERVICE_URL=mongodb+srv://username:password@cluster0.xxxxx.mongodb.net/ecommerce_users
MONGO_PRODUCT_SERVICE_URL=mongodb+srv://username:password@cluster0.xxxxx.mongodb.net/ecommerce_products
MONGO_ORDER_SERVICE_URL=mongodb+srv://username:password@cluster0.xxxxx.mongodb.net/ecommerce_orders

# For local development, use:
# MONGO_USER_SERVICE_URL=mongodb://localhost:27017/ecommerce_users
# MONGO_PRODUCT_SERVICE_URL=mongodb://localhost:27017/ecommerce_products
# MONGO_ORDER_SERVICE_URL=mongodb://localhost:27017/ecommerce_orders

# JWT Configuration
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
JWT_EXPIRE=7d
JWT_REFRESH_SECRET=your_super_secret_refresh_key_change_this
JWT_REFRESH_EXPIRE=30d

# Redis Cache Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# CORS
CORS_ORIGIN=http://localhost:3000

# Database fallback (development helper)
# When true, if Atlas is unreachable backend retries using local MongoDB URLs.
DB_FALLBACK_TO_LOCAL=true

# API Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Cache TTL (in seconds)
CACHE_TTL=3600
DATABASE_CACHE_TTL=300
